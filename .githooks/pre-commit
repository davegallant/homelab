#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-$REPO_ROOT/ansible/.vault_pass}"

if [[ "$VAULT_PASSWORD_FILE" != /* ]]; then
  VAULT_PASSWORD_FILE="$REPO_ROOT/$VAULT_PASSWORD_FILE"
fi

if [[ ! -f "$VAULT_PASSWORD_FILE" ]]; then
  printf 'Ansible Vault password file not found: %s\n' "$VAULT_PASSWORD_FILE" >&2
  printf 'Set ANSIBLE_VAULT_PASSWORD_FILE or create ansible/.vault_pass.\n' >&2
  exit 1
fi

export ANSIBLE_VAULT_PASSWORD_FILE="$VAULT_PASSWORD_FILE"
cd "$REPO_ROOT"
exec just lint
