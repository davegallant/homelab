apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - {{ talos_node_ip_subnet | default(talos_kubelet_node_ip_subnet) }}
---
cluster:
  proxy:
    disabled: true
machine:
  network:
    interfaces:
      - interface: {{ talos_network_interface }}
        dhcp: false
        addresses:
          - {{ talos_node_ip }}/{{ talos_network_cidr }}
{% if talos_extra_address_cidrs is defined and talos_extra_address_cidrs %}
{% for addr in talos_extra_address_cidrs %}
          - {{ addr }}
{% endfor %}
{% endif %}
        routes:
          - network: 0.0.0.0/0
            gateway: {{ talos_default_gateway }}
{% if talos_default_route_source | default('') %}
            source: {{ talos_default_route_source }}
{% endif %}
  files:
    - content: Talos local Homepage storage root
      permissions: 0644
      path: /var/mnt/homepage/config/.keep
      op: create
    - content: Talos local-path-provisioner storage root
      permissions: 0644
      path: /var/mnt/local-path/.keep
      op: create
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
{% for server in talos_dns_servers %}
  - address: {{ server }}
{% endfor %}
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  imageMaximumGCAge: 720h
  imageGCHighThresholdPercent: 75
  imageGCLowThresholdPercent: 65
