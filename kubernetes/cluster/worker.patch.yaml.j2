apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - {{ talos_node_ip_subnet | default(talos_kubelet_node_ip_subnet) }}
---
cluster:
  proxy:
    disabled: true
machine:
  network:
    interfaces:
      - interface: {{ talos_network_interface }}
        dhcp: false
        addresses:
          - {{ talos_node_ip }}/{{ talos_network_cidr }}
{% if talos_extra_address_cidrs is defined and talos_extra_address_cidrs %}
{% for addr in talos_extra_address_cidrs %}
          - {{ addr }}
{% endfor %}
{% endif %}
        routes:
          - network: 0.0.0.0/0
            gateway: {{ talos_default_gateway }}
{% if talos_default_route_source | default('') %}
            source: {{ talos_default_route_source }}
{% endif %}
    # Node-level pulls (arca image pulls from Forgejo) resolve to the lan-gateway VIP.
    extraHostEntries:
      - ip: 192.168.1.186
        aliases:
          - forgejo.davegallant.ca
{% if talos_dhi_registry_username is defined and talos_dhi_registry_username | length > 0 and talos_dhi_registry_password is defined and talos_dhi_registry_password | length > 0 %}
  # Docker Hardened Images (dhi.io) pull credentials. Vars are intentionally
  # NOT in vars.yaml (never put machine secrets there): supply them via
  # --extra-vars from a Vault-encrypted file when running generate-config.
  # Without them this block renders nothing.
  registries:
    config:
      dhi.io:
        auth:
          username: "{{ talos_dhi_registry_username }}"
          password: "{{ talos_dhi_registry_password }}"
{% endif %}
  files:
    - content: Talos local Homepage storage root
      permissions: 0644
      path: /var/mnt/homepage/config/.keep
      op: create
{% for root in talos_node_storage_roots | default([]) %}
    - content: "{{ root.content }}"
      permissions: 0644
      path: {{ root.path }}
      op: create
{% endfor %}
    - content: Talos local-path-provisioner storage root
      permissions: 0644
      path: /var/mnt/local-path/.keep
      op: create
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
{% for server in talos_dns_servers %}
  - address: {{ server }}
{% endfor %}
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  imageMaximumGCAge: 720h
  imageGCHighThresholdPercent: 75
  imageGCLowThresholdPercent: 65
