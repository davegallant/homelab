apiVersion: v1alpha1
kind: KubeProxyConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - {{ talos_kubelet_node_ip_subnet }}
---
cluster:
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v{{ kubernetes_version }}
machine:
  network:
    interfaces:
      - interface: {{ talos_network_interface }}
        dhcp: false
        addresses:
          - {{ talos_control_plane_ip }}/{{ talos_network_cidr }}
        routes:
          - network: 0.0.0.0/0
            gateway: {{ talos_default_gateway }}
{% if talos_dhi_registry_username is defined and talos_dhi_registry_username | length > 0 and talos_dhi_registry_password is defined and talos_dhi_registry_password | length > 0 %}
  # Docker Hardened Images (dhi.io) pull credentials. Vars are intentionally
  # NOT in vars.yaml (never put machine secrets there): supply them via
  # --extra-vars from a Vault-encrypted file when running generate-config.
  # Without them this block renders nothing.
  registries:
    config:
      dhi.io:
        auth:
          username: "{{ talos_dhi_registry_username }}"
          password: "{{ talos_dhi_registry_password }}"
{% endif %}
  files:
    - content: Talos local Homepage storage root
      permissions: 0644
      path: /var/mnt/homepage/config/.keep
      op: create
    - content: Talos local Homepage storage root
      permissions: 0644
      path: /var/mnt/homepage/tailscale/.keep
      op: create
    - content: Talos local Homepage storage root
      permissions: 0644
      path: /var/mnt/homepage/caddy/.keep
      op: create
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
{% for server in talos_dns_servers %}
  - address: {{ server }}
{% endfor %}
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  imageMaximumGCAge: 720h
