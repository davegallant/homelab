# Ansible-to-Helm values bridge for the bentopdf chart.
#
# Rendered by playbooks/talos-cluster/bentopdf.yml into a protected
# temporary file (0600, deleted after the run) and passed to Helm with
# -f. All three variables already exist in Ansible Vault (they fed the
# LXC Compose stack); no new Vault entries are needed.
# Never commit a rendered copy.
newt:
  pangolinEndpoint: {{ pangolin_endpoint | to_json }}
  id: {{ bentopdf_newt_id | to_json }}
  secret: {{ bentopdf_newt_secret | to_json }}
