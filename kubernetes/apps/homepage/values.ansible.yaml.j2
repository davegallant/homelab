# Ansible-to-Helm values bridge for the homepage chart.
#
# Rendered by playbooks/talos-cluster/homepage.yml into a protected
# temporary file (0600, deleted after the run) and passed to Helm with
# -f. This is the ONLY channel through which Vault/group_vars values and
# the rendered config files reach the chart. Never commit a rendered copy.
magicDnsDomain: {{ headscale_magic_dns_domain | to_json }}
headscaleDomain: {{ headscale_server_domain | to_json }}
tailscaleHostname: {{ homepage_tailscale_hostname | to_json }}
restartTimestamp: {{ homepage_restart_timestamp | default('') | to_json }}
cloudflareApiToken: {{ cloudflare_dns_api_token | to_json }}
configFiles:
  servicesYaml: {{ lookup('ansible.builtin.template', playbook_dir + '/../../../kubernetes/apps/homepage/config/services.yaml') | to_json }}
  settingsYaml: {{ lookup('ansible.builtin.template', playbook_dir + '/../../../kubernetes/apps/homepage/config/settings.yaml') | to_json }}
  widgetsYaml: {{ lookup('ansible.builtin.file', playbook_dir + '/../../../kubernetes/apps/homepage/config/widgets.yaml') | to_json }}
  proxyAgentCjs: {{ lookup('ansible.builtin.file', playbook_dir + '/../../../kubernetes/apps/homepage/proxy-agent.cjs') | to_json }}
homepageEnv:
  HOMEPAGE_VAR_GOTIFY_API_KEY: {{ homepage_gotify_api_key | to_json }}
  HOMEPAGE_VAR_IMMICH_API_KEY: {{ homepage_immich_api_key | to_json }}
  HOMEPAGE_VAR_ADGUARD_HOME_USERNAME: {{ homepage_adguard_home_username | to_json }}
  HOMEPAGE_VAR_ADGUARD_HOME_PASSWORD: {{ homepage_adguard_home_password | to_json }}
  HOMEPAGE_VAR_TRUENAS_API_KEY: {{ homepage_truenas_api_key | to_json }}
  HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY: {{ homepage_openweathermap_api_key | to_json }}
  HOMEPAGE_VAR_GATUS_URL: {{ gatus_url | to_json }}
  HOMEPAGE_VAR_SPEEDTEST_TRACKER_URL: {{ speedtest_tracker_url | to_json }}
  HOMEPAGE_VAR_JELLYFIN_URL: {{ jellyfin_url | to_json }}
  HOMEPAGE_VAR_GOTIFY_URL: {{ gotify_server_url | to_json }}
  HOMEPAGE_VAR_IMMICH_URL: {{ immich_url | to_json }}
  HOMEPAGE_VAR_ADGUARD_HOME_URL: {{ adguard_home_url | to_json }}
  HOMEPAGE_VAR_TRUENAS_URL: {{ truenas_url | to_json }}
  HOMEPAGE_VAR_PROXMOX_URL: {{ proxmox_url | to_json }}
  HOMEPAGE_VAR_PROXMENUX_G3_1_URL: {{ proxmenux_g3_1_url | to_json }}
  HOMEPAGE_VAR_PROXMENUX_G3_2_URL: {{ proxmenux_g3_2_url | to_json }}
  HOMEPAGE_VAR_OPNSENSE_URL: {{ opnsense_url | to_json }}
  HOMEPAGE_VAR_HOMEASSISTANT_URL: {{ homeassistant_url | to_json }}
  HOMEPAGE_VAR_AUDIOBOOKSHELF_URL: {{ audiobookshelf_url | to_json }}
  HOMEPAGE_VAR_MALOJA_URL: {{ maloja_url | to_json }}
  HOMEPAGE_VAR_FORGEJO_URL: {{ forgejo_url | to_json }}
  HOMEPAGE_VAR_NAVIDROME_URL: {{ navidrome_url | to_json }}
  HOMEPAGE_VAR_INVIDIOUS_URL: {{ invidious_url | to_json }}
  HOMEPAGE_VAR_CHANGEDETECTION_URL: {{ changedetection_url | to_json }}
  HOMEPAGE_VAR_BENTOPDF_URL: {{ bentopdf_url | to_json }}
  HOMEPAGE_VAR_LUBELOGGER_URL: {{ lubelogger_url | to_json }}
  HOMEPAGE_VAR_GRAFANA_URL: {{ grafana_url | to_json }}
  HOMEPAGE_VAR_BESZEL_URL: {{ beszel_url | to_json }}
  HOMEPAGE_VAR_PROWLARR_URL: {{ prowlarr_url | to_json }}
  HOMEPAGE_VAR_UMAMI_URL: {{ umami_url | to_json }}
