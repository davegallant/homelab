  HOMEPAGE_VAR_MINIFLUX_URL: {{ miniflux_url | to_json }}
  HOMEPAGE_VAR_SONARR_URL: {{ sonarr_url | to_json }}
  HOMEPAGE_VAR_RADARR_URL: {{ radarr_url | to_json }}
