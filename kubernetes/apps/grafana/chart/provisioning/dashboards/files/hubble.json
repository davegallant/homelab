{
  "uid": "hubble",
  "title": "Hubble",
  "description": "Hubble metrics are scraped once by Alloy's annotation-driven service job. Drop metrics include the source workload; the scrape target is the Cilium agent endpoint IP. DNS visibility is limited to workloads with L7 DNS policies; HTTP L7 visibility is not configured.",
  "tags": ["talos", "cilium", "hubble"],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Flows by verdict",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (instance, type, protocol, verdict) (rate(hubble_flows_processed_total{job=\"prometheus.scrape.annotated_services\"}[5m]))",
          "legendFormat": "{{instance}} / {{type}} / {{protocol}} / {{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Drops by reason",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (source, instance, protocol, reason) (rate(hubble_drop_total{job=\"prometheus.scrape.annotated_services\", source!=\"\"}[5m]))",
          "legendFormat": "{{source}} / {{protocol}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top drops by source workload, protocol, and reason",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "topk(10, sum by (source, instance, protocol, reason) (rate(hubble_drop_total{job=\"prometheus.scrape.annotated_services\", source!=\"\"}[5m])) > 0)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Forwarded events by agent endpoint, protocol, and type",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (instance, protocol, type) (rate(hubble_flows_processed_total{job=\"prometheus.scrape.annotated_services\", verdict=\"FORWARDED\"}[5m]))",
          "legendFormat": "{{instance}} / {{protocol}} / {{type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
