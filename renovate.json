{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "on the 1st day of the month"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with a renovate: comment",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/vars\\.yaml$/",
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*[A-Za-z_]+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Argo CD image tag and digest",
      "managerFilePatterns": [
        "/^kubernetes/apps/argocd/values\\.yaml$/"
      ],
      "matchStrings": [
        "tag: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "autoReplaceStringTemplate": "tag: {{{newValue}}}@{{{newDigest}}}",
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/argoproj/argocd"
    },
    {
      "customType": "regex",
      "description": "Cilium chart version in Ansible-rendered Application",
      "managerFilePatterns": [
        "/^kubernetes/apps/cilium/vars\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=cilium registryUrl=https://helm\\.cilium\\.io/\\n\\s*cilium_chart_version: \\\"(?<currentValue>[^\\\"\\s]+)\\\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io/",
      "versioningTemplate": "semver"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/apps/argocd/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^kubernetes/apps/.+/values[^/]*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/apps/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Nothing auto-merges: a merge to main applies to live hosts",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Keep Helm values image digests in their separate digest fields",
      "matchManagers": [
        "helm-values"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep the beszel agent .deb and the beszel hub image in lockstep",
      "matchPackageNames": [
        "henrygd/beszel",
        "docker.io/henrygd/beszel"
      ],
      "groupName": "beszel"
    },
    {
      "matchDepNames": [
        "docker.io/searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$"
    },
    {
      "matchDepNames": [
        "quay.io/invidious/invidious",
        "quay.io/invidious/invidious-companion"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$"
    }
  ]
}
