{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "on the 1st day of the month"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with a renovate: comment",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/vars\\.yaml$/",
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*[A-Za-z_]+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Argo CD image tag and digest",
      "managerFilePatterns": [
        "/^kubernetes/apps/argocd/values\\.yaml$/"
      ],
      "matchStrings": [
        "tag: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "autoReplaceStringTemplate": "tag: {{{newValue}}}@{{{newDigest}}}",
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/argoproj/argocd"
    },
    {
      "customType": "regex",
      "description": "Cilium chart version in Ansible-rendered Application",
      "managerFilePatterns": [
        "/^kubernetes/apps/cilium/vars\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=cilium registryUrl=https://helm\\.cilium\\.io/\\n\\s*cilium_chart_version: \\\"(?<currentValue>[^\\\"\\s]+)\\\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io/",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Keep Kubernetes Helm image tags and digests in sync",
      "managerFilePatterns": [
        "/^kubernetes/apps/audiobookshelf/values\\.production\\.yaml$/",
        "/^kubernetes/apps/beszel/values\\.production\\.yaml$/",
        "/^kubernetes/apps/changedetection/values\\.production\\.yaml$/",
        "/^kubernetes/apps/forgejo/values\\.production\\.yaml$/",
        "/^kubernetes/apps/immich/values\\.production\\.yaml$/",
        "/^kubernetes/apps/invidious/values\\.production\\.yaml$/",
        "/^kubernetes/apps/jellyfin/values\\.production\\.yaml$/",
        "/^kubernetes/apps/k8s-readonly/values\\.production\\.yaml$/",
        "/^kubernetes/apps/lidarr/values\\.production\\.yaml$/",
        "/^kubernetes/apps/lubelogger/values\\.production\\.yaml$/",
        "/^kubernetes/apps/maloja/values\\.production\\.yaml$/",
        "/^kubernetes/apps/navidrome/values\\.production\\.yaml$/",
        "/^kubernetes/apps/paperless-ngx/values\\.production\\.yaml$/",
        "/^kubernetes/apps/prowlarr/values\\.production\\.yaml$/",
        "/^kubernetes/apps/qbittorrent/values\\.production\\.yaml$/",
        "/^kubernetes/apps/radarr/values\\.production\\.yaml$/",
        "/^kubernetes/apps/romm/values\\.production\\.yaml$/",
        "/^kubernetes/apps/seerr/values\\.production\\.yaml$/",
        "/^kubernetes/apps/sonarr/values\\.production\\.yaml$/",
        "/^kubernetes/apps/speedtest-tracker/values\\.production\\.yaml$/",
        "/^kubernetes/apps/umami/values\\.production\\.yaml$/"
      ],
      "matchStrings": [
        "(?:(?<registryIndent>[ \\t]*)registry: (?<registry>[^ \\t\\n]+)\\n)?(?<repoIndent>[ \\t]*)repository: (?<depName>[^ \\t\\n]+)(?<repoComments>(?:\\n[ \\t]*#[^\\n]*)*)\\n(?<fieldIndent>[ \\t]+)tag: [\\\"]?(?<currentValue>[^\\\"\\s]+)[\\\"]?\\n[ \\t]+digest: (?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "{{#if registry}}{{{registry}}}/{{{depName}}}{{else}}{{{depName}}}{{/if}}",
      "autoReplaceStringTemplate": "{{#if registry}}{{{registryIndent}}}registry: {{{registry}}}\n{{/if}}{{{repoIndent}}}repository: {{{depName}}}{{{repoComments}}}\n{{{fieldIndent}}}tag: \"{{{newValue}}}\"\n{{{fieldIndent}}}digest: {{{newDigest}}}",
      "datasourceTemplate": "docker"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/apps/argocd/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^kubernetes/apps/.+/values[^/]*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/apps/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Nothing auto-merges: a merge to main applies to live hosts",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Keep the beszel agent .deb and the beszel hub image in lockstep",
      "matchPackageNames": [
        "henrygd/beszel",
        "docker.io/henrygd/beszel"
      ],
      "groupName": "beszel"
    },
    {
      "matchDepNames": [
        "docker.io/searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$"
    },
    {
      "matchDepNames": [
        "quay.io/invidious/invidious",
        "quay.io/invidious/invidious-companion"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$"
    },
    {
      "description": "Use the custom manager for Helm images with separate tag and digest fields",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "kubernetes/apps/audiobookshelf/values.production.yaml",
        "kubernetes/apps/beszel/values.production.yaml",
        "kubernetes/apps/changedetection/values.production.yaml",
        "kubernetes/apps/immich/values.production.yaml",
        "kubernetes/apps/invidious/values.production.yaml",
        "kubernetes/apps/jellyfin/values.production.yaml",
        "kubernetes/apps/k8s-readonly/values.production.yaml",
        "kubernetes/apps/lidarr/values.production.yaml",
        "kubernetes/apps/lubelogger/values.production.yaml",
        "kubernetes/apps/maloja/values.production.yaml",
        "kubernetes/apps/navidrome/values.production.yaml",
        "kubernetes/apps/paperless-ngx/values.production.yaml",
        "kubernetes/apps/prowlarr/values.production.yaml",
        "kubernetes/apps/qbittorrent/values.production.yaml",
        "kubernetes/apps/radarr/values.production.yaml",
        "kubernetes/apps/romm/values.production.yaml",
        "kubernetes/apps/seerr/values.production.yaml",
        "kubernetes/apps/sonarr/values.production.yaml",
        "kubernetes/apps/speedtest-tracker/values.production.yaml",
        "kubernetes/apps/umami/values.production.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Use the custom manager for Forgejo\u2019s separate image tag and digest fields",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "kubernetes/apps/forgejo/values.production.yaml"
      ],
      "matchDepNames": [
        "codeberg.org/forgejo/forgejo"
      ],
      "enabled": false
    }
  ]
}
