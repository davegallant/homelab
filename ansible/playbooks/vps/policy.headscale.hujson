// Headscale ACL policy — converted from Tailscale SaaS policy.hujson.
// Changes from the SaaS version:
//   1. Removed nodeAttrs (Funnel is a Tailscale SaaS feature, not in Headscale).
//   2. tagOwners lists all tags referenced in acls/ssh (Headscale requires
//      every tag to be defined). Existing service tags have no user owners;
//      tag:nanoclaw is owned by dave@ so its personal node can be converted
//      to a tagged node. The VPS playbook applies the configured node tags.
//   3. SSH covers every node via autogroup:member + autogroup:tagged
//      (Headscale rejects "*" as an SSH dst), replacing the SaaS
//      per-tag/self rules — tagged nodes never match autogroup:self,
//      so per-tag rules needed constant upkeep.
{
	// Access control lists.
	"acls": [
		// Monitored hosts send logs to Loki and metrics to Beszel.
		{
			"action": "accept",
			"proto":  "tcp",
			"src":    ["tag:monitored"],
			"dst":    ["100.100.0.8:443", "tag:loki:3100"],
		},
		// Grafana can reach the tailnet Gateway HTTPS fronting node.
		{
			"action": "accept",
			"proto":  "tcp",
			"src":    ["100.100.0.14"],
			"dst":    ["100.100.0.8:443"],
		},
		// The remote GL-MT3000 reports metrics directly to the Beszel hub.
		{
			"action": "accept",
			"proto":  "tcp",
			"src":    ["tag:beszel-agent"],
			"dst":    ["100.100.0.8:443"],
		},
		// Beszel agents on the two active tagged hosts use the Gateway after sidecar retirement.
		{
			"action": "accept",
			"proto":  "tcp",
			"src":    ["100.100.0.33", "100.100.0.34"],
			"dst":    ["100.100.0.8:443"],
		},
		// Muse can read Gatus health status over its tailnet HTTPS endpoint.
		{
			"action": "accept",
			"src":    ["100.100.0.48"],
			"dst":    ["100.100.0.11:443"],
		},
		// Muse can read the k8s-readonly API proxy over its tailnet HTTPS endpoint (IP source,
		// following the Gatus pattern - NOT tag:external, to avoid granting kratos/mcleod and
		// to pass the tag:external deny dave@:443 test).
		{
			"action": "accept",
			"src":    ["100.100.0.48"],
			"dst":    ["100.100.0.8:443"],
		},
		// NanoClaw can reach the shared HTTPS gateway for k8s-readonly. The
		// gateway also serves other hostnames on this same IP/port; Headscale
		// cannot filter by hostname, so this matches Muse's network permission.
		{
			"action": "accept",
			"proto":  "tcp",
			"src":    ["tag:nanoclaw"],
			"dst":    ["100.100.0.8:443"],
		},
		// Match tailnet IPs for user-owned member devices. (On Headscale
		// >= 0.28 "*" only covers 100.64.0.0/10 — internet-bound traffic
		// needs the explicit rule below.) Tagged devices are excluded as
		// sources.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["*:*"],
		},
		// Tagged nodes use the tailnet DNS resolvers for MagicDNS and filtering.
		{
			"action": "accept",
			"src":    ["tag:external", "tag:beszel-agent", "tag:monitored", "tag:nanoclaw"],
			"dst":    ["100.100.0.11:53", "100.100.0.24:53"],
		},
		// Allow members to use exit nodes (internet-bound traffic).
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:internet:*"],
		},
	],

	"ssh": [
		// Allow tailnet members to SSH into every node, tagged or not
		// (matches the old Tailscale SaaS behaviour). Headscale rejects
		// "*" as an SSH destination, so this is two rules: user-owned
		// devices via autogroup:member, tagged devices via
		// autogroup:tagged. Tagged nodes are not members, so they can
		// never use these rules as a source. Remote hosts use tag:external,
		// and Newt hosts use tag:pangolin. They can receive SSH but cannot
		// initiate Tailscale SSH to any node.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:member"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:tagged"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Keep the tagged-node boundary intact when changing access rules.
	"tests": [
		{
			"src":   "tag:external",
			"proto": "tcp",
			"deny":  ["dave@:443", "tag:loki:3100", "tag:pangolin:443"],
		},
		{
			"src":    "tag:external",
			"proto":  "udp",
			"accept": ["100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["100.100.0.8:53"],
		},
		{
			"src":    "tag:beszel-agent",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443", "100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["tag:loki:3100", "tag:pangolin:443"],
		},
		{
			"src":    "100.100.0.33",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443"],
			"deny":   ["100.100.0.8:80", "100.100.0.8:444", "100.100.0.22:443", "100.100.0.11:443", "100.100.0.1:443"],
		},
		{
			"src":    "100.100.0.34",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443"],
			"deny":   ["100.100.0.8:80", "100.100.0.8:444", "100.100.0.22:443", "100.100.0.11:443", "100.100.0.1:443"],
		},
		{
			"src":   "100.100.0.33",
			"proto": "udp",
			"deny":  ["100.100.0.8:443"],
		},
		{
			"src":   "100.100.0.34",
			"proto": "udp",
			"deny":  ["100.100.0.8:443"],
		},
		// Muse may query Gatus but has no access to Beszel or other tagged services.
		{
			"src":    "100.100.0.48",
			"proto":  "tcp",
			"accept": ["100.100.0.11:443", "100.100.0.8:443"],
			"deny":   ["tag:loki:3100", "tag:pangolin:443"],
		},
		// NanoClaw gets the k8s-readonly gateway path and DNS, without Muse's Gatus access.
		{
			"src":    "tag:nanoclaw",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443", "100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["100.100.0.11:443", "100.100.0.22:443", "100.100.0.1:443", "tag:loki:3100", "tag:pangolin:443"],
		},
		{
			"src":    "tag:nanoclaw",
			"proto":  "udp",
			"accept": ["100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["100.100.0.8:53"],
		},
		{
			"src":    "tag:external",
			"proto":  "tcp",
			"accept": ["100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["dave@:443"],
		},
		{
			"src":    "tag:monitored",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443", "tag:loki:3100"],
			"deny":   ["100.100.0.22:443", "100.100.0.11:443", "100.100.0.1:443", "tag:external:443", "tag:pangolin:443"],
		},
		{
			"src":    "tag:monitored",
			"proto":  "udp",
			"accept": ["100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["100.100.0.8:53"],
		},
		{
			"src":    "tag:monitored",
			"proto":  "tcp",
			"accept": ["100.100.0.11:53", "100.100.0.24:53"],
			"deny":   ["100.100.0.22:443", "100.100.0.11:443", "100.100.0.1:443"],
		},
		// Grafana may reach Gateway HTTPS but not the listed Dave-owned HTTPS endpoints.
		{
			"src":    "100.100.0.14",
			"proto":  "tcp",
			"accept": ["100.100.0.8:443"],
			"deny":   ["100.100.0.8:80", "100.100.0.8:444", "100.100.0.22:443", "100.100.0.11:443", "100.100.0.1:443"],
		},
		{
			"src":   "100.100.0.14",
			"proto": "udp",
			"deny":  ["100.100.0.8:443"],
		},
	],
	"sshTests": [
		{
			"src":  "tag:external",
			"dst":  ["dave@", "tag:external", "tag:pangolin", "tag:monitored", "tag:loki"],
			"deny": ["root"],
		},
		{
			"src":  "tag:beszel-agent",
			"dst":  ["dave@", "tag:external", "tag:beszel-agent", "tag:pangolin", "tag:monitored", "tag:loki"],
			"deny": ["root"],
		},
		{
			"src":    "dave@",
			"dst":    ["tag:external", "tag:pangolin", "tag:monitored", "tag:loki"],
			"accept": ["root"],
		},
		{
			"src":  "tag:pangolin",
			"dst":  ["dave@", "tag:external", "tag:pangolin", "tag:monitored", "tag:loki"],
			"deny": ["root"],
		},
		{
			"src":  "tag:monitored",
			"dst":  ["dave@", "tag:external", "tag:pangolin", "tag:monitored", "tag:loki"],
			"deny": ["root"],
		},
		{
			"src":    "dave@",
			"dst":    ["tag:pangolin"],
			"accept": ["root"],
		},
		{
			"src":    "dave@",
			"dst":    ["tag:nanoclaw"],
			"accept": ["root"],
		},
		{
			"src":   "tag:nanoclaw",
			"dst":   ["dave@", "tag:external", "tag:pangolin", "tag:monitored", "tag:loki"],
			"deny": ["root"],
		},
	],

	// All tags referenced in acls/ssh must be defined here, even if empty.
	"tagOwners": {
		"tag:pangolin":  [],
		"tag:beszel-agent": [],
		"tag:loki":      [],
		"tag:monitored": [],
		"tag:external":  [],
		"tag:nanoclaw":  ["dave@"],
	},
}
