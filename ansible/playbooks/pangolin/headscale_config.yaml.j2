# Managed by Ansible (playbooks/pangolin).
server_url: https://{{ headscale_server_domain }}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: ""
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: {{ headscale_v4_prefix }}
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

policy:
  mode: database

dns:
  magic_dns: true
  base_domain: "{{ headscale_magic_dns_domain }}"
  override_local_dns: true
  extra_records:
    - name: "homepage.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "changedetection.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "k8s-readonly.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "prowlarr.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "romm.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "lubelogger.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "radarr.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "sonarr.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "lidarr.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "seerr.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
    - name: "kiwix.{{ headscale_magic_dns_domain }}"
      type: A
      value: "100.100.0.8"
  nameservers:
    global:
      - 100.100.0.24
      - {{ headscale_secondary_dns_ip }}

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

log:
  level: warn
  format: text
