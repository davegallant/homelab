# Managed by Ansible (playbooks/pangolin). Upstream reference:
# https://docs.pangolin.net/self-host/manual/docker-compose
# Structure verified against the VPS's live ~/config/config.yml (2026-10-03).
# server.secret comes from the vault and MUST match the live value.

gerbil:
  start_port: 51820
  base_endpoint: "{{ pangolin_dashboard_domain }}"

app:
  dashboard_url: "https://{{ pangolin_dashboard_domain }}"
  log_level: "info"
  telemetry:
    anonymous_usage: false

domains:
  domain1:
    base_domain: "{{ pangolin_base_domain }}"

server:
  secret: "{{ pangolin_server_secret }}"
  cors:
    origins: ["https://{{ pangolin_dashboard_domain }}"]
    methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
    allowed_headers: ["X-CSRF-Token", "Content-Type"]
    credentials: false

flags:
  require_email_verification: false
  disable_signup_without_invite: true
  disable_user_create_org: false
  allow_raw_resources: true
