# Managed by Ansible (playbooks/pangolin). Upstream reference:
# https://docs.pangolin.net/self-host/manual/docker-compose
# NOTE: api.insecure exposes the Traefik dashboard. That matches the current
# manual deployment; consider restricting it once this is under Ansible.
api:
  insecure: true
  dashboard: true
providers:
  http:
    endpoint: "http://pangolin:3001/api/v1/traefik-config"
    pollInterval: "5s"
  file:
    filename: "/etc/traefik/dynamic_config.yml"
experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "v1.7.0"
log:
  level: "INFO"
  format: "common"
  maxSize: 100
  maxBackups: 3
  maxAge: 3
  compress: true
certificatesResolvers:
  letsencrypt:
    acme:
      httpChallenge:
        entryPoint: web
      email: "{{ pangolin_letsencrypt_email }}"
      storage: "/letsencrypt/acme.json"
      caServer: "https://acme-v02.api.letsencrypt.org/directory"
entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: "30m"
    http:
      tls:
        certResolver: "letsencrypt"
  udp-19132:
    address: ":19132/udp"
serversTransport:
  insecureSkipVerify: true
ping:
  entryPoint: "web"
