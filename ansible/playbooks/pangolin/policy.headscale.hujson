// Headscale ACL policy — converted from Tailscale SaaS policy.hujson.
// Changes from the SaaS version:
//   1. Removed nodeAttrs (Funnel is a Tailscale SaaS feature, not in Headscale).
//   2. tagOwners lists all tags referenced in acls/ssh (Headscale requires
//      every tag to be defined). All set to [] (no one can assign yet) —
//      update when you need to actually tag nodes. Headscale v0.29.3 rejects
//      both plain usernames and autogroup:member as owners.
//   3. SSH covers every node via autogroup:member + autogroup:tagged
//      (Headscale rejects "*" as an SSH dst), replacing the SaaS
//      per-tag/self rules — tagged nodes never match autogroup:self,
//      so per-tag rules needed constant upkeep.
{
	// Access control lists.
	"acls": [
		// Ensure that pangolin machines cannot communicate with other nodes,
		{
			"action": "accept",
			"src":    ["tag:pangolin"],
			"dst":    ["tag:pangolin:*"],
		},
		// Allow Navidrome to submit scrobbles to Maloja.
		{
			"action": "accept",
			"src":    ["tag:navidrome"],
			"dst":    ["tag:maloja:*"],
		},
		// Allow the Beszel agent on Pangolin machines to reach the Beszel hub.
		{
			"action": "accept",
			"src":    ["tag:pangolin"],
			"dst":    ["tag:beszel:*"],
		},
		// Allow tailnet members to access work machines. Work machines should
		// be tagged tag:work so they do not match autogroup:member as sources.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:work:*"],
		},
		// Match tailnet IPs for user-owned member devices. (On Headscale
		// >= 0.28 "*" only covers 100.64.0.0/10 — internet-bound traffic
		// needs the explicit rule below.) Tagged devices like work machines
		// are excluded as sources.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["*:*"],
		},
		// Remote hosts can reach tailnet services, but not SSH on port 22.
		// Tailscale SSH also requires an SSH rule, and tag:external is not
		// included as a source in any of those rules.
		{
			"action": "accept",
			"src":    ["tag:external"],
			"dst":    ["*:1-21,23-65535"],
		},
		// Allow members to use exit nodes (internet-bound traffic).
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:internet:*"],
		},
	],

	"ssh": [
		// Allow tailnet members to SSH into every node, tagged or not
		// (matches the old Tailscale SaaS behaviour). Headscale rejects
		// "*" as an SSH destination, so this is two rules: user-owned
		// devices via autogroup:member, tagged devices via
		// autogroup:tagged. Tagged nodes are not members, so they can
		// never use these rules as a source. Tag remote hosts such as muse
		// and mcleod with tag:external so they can receive SSH but cannot
		// initiate Tailscale SSH to any node.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:member"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:tagged"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Keep the remote-host boundary intact when changing access rules.
	"tests": [
		{
			"src":    "tag:external",
			"proto":  "tcp",
			"accept": ["dave@:443"],
			"deny":   ["dave@:22"],
		},
	],
	"sshTests": [
		{
			"src":  "tag:external",
			"dst":  ["dave@"],
			"deny": ["root"],
		},
		{
			"src":    "dave@",
			"dst":    ["tag:external"],
			"accept": ["root"],
		},
	],

	// All tags referenced in acls/ssh must be defined here, even if empty.
	"tagOwners": {
		"tag:pangolin":  [],
		"tag:navidrome": [],
		"tag:maloja":    [],
		"tag:beszel":    [],
		"tag:work":      [],
		"tag:external":  [],
	},
}
