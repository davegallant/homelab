{
  "uid": "hubble",
  "title": "Hubble",
  "description": "Hubble metrics attributed by scrape node, protocol, flow type, verdict, and drop reason. Queries select job=\"hubble\" to avoid duplicate samples from Alloy's annotation-driven scrape job. Hubble metrics do not currently emit source or destination pod labels; namespace is only the cilium-system scrape-target namespace. DNS/HTTP panels remain deferred until L7/FQDN policies are used. No datapath or policy change; read-only observability.",
  "tags": ["talos", "cilium", "hubble"],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Flows by verdict",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (node, type, protocol, verdict) (rate(hubble_flows_processed_total{job=\"hubble\"}[5m]))",
          "legendFormat": "{{node}} / {{type}} / {{protocol}} / {{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Drops by reason",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (node, protocol, reason) (rate(hubble_drop_total{job=\"hubble\"}[5m]))",
          "legendFormat": "{{node}} / {{protocol}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top drops by node, protocol, and reason",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "topk(10, sum by (node, protocol, reason) (rate(hubble_drop_total{job=\"hubble\"}[5m])) > 0)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Forwarded events by node, protocol, and type",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (node, protocol, type) (rate(hubble_flows_processed_total{job=\"hubble\", verdict=\"FORWARDED\"}[5m]))",
          "legendFormat": "{{node}} / {{protocol}} / {{type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
