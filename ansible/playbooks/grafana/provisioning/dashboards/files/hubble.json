{
  "uid": "hubble",
  "title": "Hubble",
  "description": "Cilium Hubble flow visibility: forwarded vs dropped flows, drops by reason and namespace, DNS responses, HTTP status. Series are scraped by Alloy from the Cilium agent hubble-metrics port (9965) and remote-written to VictoriaMetrics. No datapath change; read-only observability.",
  "tags": ["talos", "cilium", "hubble"],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Flows by verdict",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (verdict) (rate(hubble_flows_processed_total[5m]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Drops by reason",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
