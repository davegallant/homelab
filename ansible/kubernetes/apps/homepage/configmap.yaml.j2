---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: homepage
data:
  services.yaml: |
{{ lookup('ansible.builtin.template', playbook_dir + '/../../kubernetes/apps/homepage/config/services.yaml') | indent(4, true) }}
  settings.yaml: |
{{ lookup('ansible.builtin.template', playbook_dir + '/../../kubernetes/apps/homepage/config/settings.yaml') | indent(4, true) }}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-icons
  namespace: homepage
binaryData:
{% for icon in homepage_icon_files.results %}
  {{ icon.source | basename }}: {{ icon.content }}
{% endfor %}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-node-proxy
  namespace: homepage
data:
  proxy-agent.cjs: |
{{ lookup('ansible.builtin.file', playbook_dir + '/../../kubernetes/apps/homepage/proxy-agent.cjs') | indent(4, true) }}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-caddy
  namespace: homepage
data:
  Caddyfile: |
    {
      auto_https disable_redirects
      https_port 8443
      tls_resolvers 1.1.1.1
      servers {
        protocols h1 h2
      }
    }

    homepage.{{ headscale_magic_dns_domain }} {
      bind 127.0.0.1

      tls {
        dns cloudflare {file./run/secrets/cloudflare_api_token}
        propagation_delay 30s
        propagation_timeout -1
      }

      reverse_proxy 127.0.0.1:3000
    }

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-tailscale
  namespace: homepage
data:
  serve-config.json: |
    {
      "TCP": {
        "443": {
          "TCPForward": "127.0.0.1:8443"
        }
      }
    }
