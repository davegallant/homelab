---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cilium
  namespace: argocd
spec:
  project: homelab-platform
  sources:
    - repoURL: {{ cilium_chart_repo }}
      chart: cilium
      targetRevision: "{{ cilium_chart_version }}"
      helm:
        releaseName: cilium
        valuesObject:
{{ lookup('ansible.builtin.file', playbook_dir + '/../../kubernetes/apps/cilium/values.yaml') | from_yaml | to_nice_yaml(indent=2) | indent(10, true) }}
  destination:
    server: https://kubernetes.default.svc
    namespace: cilium-system
  syncPolicy:
    syncOptions:
      - ServerSideApply=true
      - FailOnSharedResource=true
