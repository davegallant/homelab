apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-tailnet
  namespace: argocd
data:
  TS_EXTRA_ARGS: "--login-server=https://{{ headscale_server_domain }} --accept-dns=false"
  serve-config.json: |
    {"TCP": {"443": {"TCPForward": "127.0.0.1:8443"}}}
  Caddyfile: |
    {
      auto_https disable_redirects
      https_port 8443
      tls_resolvers 1.1.1.1
      servers {
        protocols h1 h2
      }
    }
    argocd.{{ headscale_magic_dns_domain }} {
      bind 127.0.0.1
      tls {
        dns cloudflare {file./run/secrets/cloudflare_api_token}
        propagation_delay 30s
        propagation_timeout -1
      }
      reverse_proxy http://127.0.0.1:8080
    }
