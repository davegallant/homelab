# Vault-backed Helm values for the searxng chart.
# Rendered by playbooks/talos-cluster/searxng.yml into a protected temporary
# directory and passed to Helm with -f. Never commit a rendered copy.
settings:
  secretKey: {{ searxng_secret_key | to_json }}
newt:
  pangolinEndpoint: {{ pangolin_endpoint | to_json }}
  id: {{ searxng_newt_id | to_json }}
  secret: {{ searxng_newt_secret | to_json }}
