---
apiVersion: v1
kind: Secret
metadata:
  name: searxng-settings
  namespace: searxng
type: Opaque
stringData:
  settings.yml: |
{{ lookup('ansible.builtin.template', playbook_dir + '/../../kubernetes/apps/searxng/settings.yaml.j2') | indent(4, true) }}

---
apiVersion: v1
kind: Secret
metadata:
  name: searxng-newt
  namespace: searxng
type: Opaque
stringData:
  PANGOLIN_ENDPOINT: {{ pangolin_endpoint | to_json }}
  NEWT_ID: {{ searxng_newt_id | to_json }}
  NEWT_SECRET: {{ searxng_newt_secret | to_json }}
