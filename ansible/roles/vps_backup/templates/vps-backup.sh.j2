#!/usr/bin/env bash
# Nightly VPS state backup. Managed by Ansible (roles/vps_backup).
#
# Backs up the ~/config state that Ansible does NOT manage (i.e. not in git):
#   - Headscale SQLite DB (nodes, routes, policy — the whole tailnet state)
#   - Headscale Noise identity key (a restored Headscale needs this)
#   - Pangolin SQLite DB (sites, resources, users)
#   - Gerbil WireGuard private key, Traefik ACME certs
# Headscale's active policy is stored in the database. Its source is maintained
# in the homelab repo and does not need a second copy in this backup.
#
# Failure handling is fully explicit and deliberately boring: every fallible
# command ends in `|| fail`. No `set -e`, no traps — nothing that can mask
# or clobber the exit status. Any failure posts to Gotify (priority 8) and
# exits 1. Success is silent. A fully-dead VPS is already covered by the
# existing Gatus check.
set -uo pipefail

CONFIG="${HOME:-/root}/config"
# /tmp is a RAM-backed tmpfs on Ubuntu and can be smaller than the SQLite DBs.
STAGING="$(mktemp -d /var/tmp/vps-backup.XXXXXX)"

backup_failed() {
    if [ -n "${GOTIFY_URL:-}" ] && [ -n "${GOTIFY_TOKEN:-}" ]; then
        curl -fsS --max-time 30 -X POST "${GOTIFY_URL%/}/message?token=${GOTIFY_TOKEN}" \
            -F "title=VPS backup failed" \
            -F "message=$1" \
            -F "priority=8" || true
    fi
}

fail() {
    backup_failed "$1"
    rm -rf "$STAGING"
    exit 1
}

# sqlite .backup with a busy timeout and retries: the DBs are live
# (Headscale/Pangolin keep writing), so transient write locks are possible.
# Keep retrying for up to 10 minutes before giving up and alerting.
sqlite_backup() {
    local src="$1" dest="$2" deadline=$((SECONDS + 600))
    while [ "$SECONDS" -lt "$deadline" ]; do
        if sqlite3 -cmd ".timeout 30000" "$src" ".backup '$dest'"; then
            return 0
        fi
        sleep 10
    done
    return 1
}

# Consistent SQLite copies while the services keep running.
sqlite_backup "$CONFIG/headscale/data/db.sqlite" "$STAGING/headscale-db.sqlite" \
    || fail "sqlite .backup of Headscale DB failed after retries on $(hostname)"
sqlite_backup "$CONFIG/db/db.sqlite" "$STAGING/pangolin-db.sqlite" \
    || fail "sqlite .backup of Pangolin DB failed after retries on $(hostname)"

# Static secrets/state.
mkdir -p "$STAGING/files" \
    || fail "creating staging dir failed on $(hostname)"
cp "$CONFIG/headscale/data/noise_private.key" "$STAGING/files/" \
    || fail "copying noise key failed on $(hostname)"
cp "$CONFIG/key" "$STAGING/files/gerbil.key" \
    || fail "copying gerbil key failed on $(hostname)"
cp "$CONFIG/letsencrypt/acme.json" "$STAGING/files/" \
    || fail "copying acme.json failed on $(hostname)"
cp "$CONFIG/headscale/config.yaml" "$STAGING/files/" \
    || fail "copying headscale config failed on $(hostname)"

restic backup "$STAGING" --tag {{ vps_backup_tag }} \
    || fail "restic backup failed on $(hostname)"
restic forget {{ vps_backup_retention }} --prune \
    || fail "restic forget/prune failed on $(hostname)"

rm -rf "$STAGING"
